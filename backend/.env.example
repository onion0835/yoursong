# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Audio Processing
MAX_AUDIO_SIZE_MB=50
SAMPLE_RATE=44100

# ============= 第三方API密钥（可选，用于更好的效果） =============

# ElevenLabs API - 高质量语音合成
# 注册地址: https://elevenlabs.io/
# 定价: $5/月起 (30,000字符)
ELEVENLABS_API_KEY=

# OpenAI API - Whisper语音识别
# 注册地址: https://platform.openai.com/
# 定价: $0.006/分钟
OPENAI_API_KEY=

# DeepL API - 高质量翻译
# 注册地址: https://www.deepl.com/pro-api
# 定价: $5/500,000字符
DEEPL_API_KEY=

# Lalal.ai API - 高质量人声分离
# 注册地址: https://www.lalal.ai/api/
# 定价: $0.15/分钟
LALAL_API_KEY=

# ============= 使用说明 =============
# 1. 复制此文件为 .env
# 2. 填入你的API密钥
# 3. 重启后端服务
# 4. 如果不配置这些密钥，将使用免费的开源方案（效果较差）
